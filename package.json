{
  "name": "@kubohiroya/turbowarp-bubble",
  "version": "0.13.0",
  "description": "Composable say and think bubbles with portrait layers and animated continue indicators for TurboWarp.",
  "author": "Hiroya Kubo <hiroya@cuc.ac.jp>",
  "type": "module",
  "license": "MPL-2.0",
  "homepage": "https://kubohiroya.github.io/turbowarp-bubble/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kubohiroya/turbowarp-bubble.git"
  },
  "bugs": {
    "url": "https://github.com/kubohiroya/turbowarp-bubble/issues"
  },
  "exports": {
    ".": {
      "types": "./dist/types/composition.d.ts",
      "import": "./dist/composition.js"
    },
    "./composition": {
      "types": "./dist/types/composition.d.ts",
      "import": "./dist/composition.js"
    },
    "./reveal": {
      "types": "./dist/types/reveal.d.ts",
      "import": "./dist/reveal.js"
    },
    "./turbowarp-adapter": {
      "types": "./dist/types/turbowarp-adapter.d.ts",
      "import": "./dist/turbowarp-adapter.js"
    },
    "./dist/turbowarp-bubble.js": "./dist/turbowarp-bubble.js",
    "./package.json": "./package.json"
  },
  "files": [
    "dist/",
    "docs/",
    "README.md",
    "README.ja.md",
    "LICENSE",
    "THIRD_PARTY_NOTICES.md"
  ],
  "main": "./dist/composition.js",
  "unpkg": "./dist/turbowarp-bubble.js",
  "jsdelivr": "./dist/turbowarp-bubble.js",
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "packageManager": "pnpm@11.18.0",
  "engines": {
    "node": ">=22.18.0"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "build": "pnpm run build:extension && pnpm run build:composition && pnpm run build:reveal && pnpm run build:turbowarp-adapter && pnpm run build:types",
    "build:extension": "vite build",
    "build:composition": "vite build --config vite.composition.config.ts",
    "build:reveal": "vite build --config vite.reveal.config.ts",
    "build:turbowarp-adapter": "vite build --config vite.turbowarp-adapter.config.ts",
    "build:types": "tsc --project tsconfig.build.json",
    "types:composition:check": "tsc --project tsconfig.composition-consumer.json",
    "lint": "eslint src tests scripts vite.config.ts vite.composition.config.ts vite.reveal.config.ts vite.turbowarp-adapter.config.ts eslint.config.mjs",
    "format": "prettier --check .",
    "format:write": "prettier --write .",
    "docs:render": "node scripts/render-block-manual-assets.ts && pnpm run docs:pages",
    "docs:pages": "node scripts/render-pages.ts",
    "docs:pages:check": "node scripts/render-pages.ts --check",
    "docs:check": "node scripts/check-block-manual.ts && pnpm run docs:pages:check",
    "benchmark:render-backends": "pnpm run build && node --expose-gc scripts/benchmark-render-backends.ts",
    "test": "vitest run",
    "check:dist": "pnpm run build && node scripts/check-dist.ts",
    "repo:check": "node scripts/check-repo.ts",
    "pack:check": "npm pack --dry-run --ignore-scripts",
    "release:check": "pnpm publish --dry-run --access public --no-git-checks",
    "check": "pnpm run typecheck && pnpm run lint && pnpm run format && pnpm run test && pnpm run docs:check && pnpm run check:dist && pnpm run types:composition:check && pnpm run repo:check && pnpm run pack:check",
    "prepack": "pnpm run check"
  },
  "peerDependencies": {
    "@kubohiroya/turbowarp-asset-cache": ">=0.1.0 <1",
    "@kubohiroya/turbowarp-async-input": ">=0.3.0 <1",
    "@kubohiroya/turbowarp-runtime-expression": ">=0.3.0 <1"
  },
  "peerDependenciesMeta": {
    "@kubohiroya/turbowarp-async-input": {
      "optional": true
    },
    "@kubohiroya/turbowarp-asset-cache": {
      "optional": true
    },
    "@kubohiroya/turbowarp-runtime-expression": {
      "optional": true
    }
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@kubohiroya/turbowarp-asset-cache": "0.1.0",
    "@kubohiroya/turbowarp-async-input": "0.7.0",
    "@kubohiroya/turbowarp-runtime-expression": "0.6.0",
    "@kubohiroya/vite-plugin-turbowarp-extension": "0.4.0",
    "@types/node": "^26.1.2",
    "eslint": "^10.8.0",
    "happy-dom": "20.0.8",
    "jsclipper": "github:platener/jsclipper#56aed19845113e1939d8971c47233054659436b1",
    "marked": "18.0.9",
    "prettier": "^3.9.6",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.66.0",
    "vite": "^8.2.0",
    "vitest": "^4.1.10"
  },
  "keywords": [
    "turbowarp",
    "scratch",
    "extension",
    "speech-bubble",
    "portrait",
    "lip-sync",
    "continue-indicator",
    "sequential-reveal",
    "bubble-animation"
  ],
  "dependencies": {
    "@cto.af/linebreak": "4.0.3",
    "@kubohiroya/turbowarp-svg-text": "0.10.0"
  }
}
